{
  "name": "driveready",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/app/sunTimes.test.js src/app/timerState.test.js src/app/routePolyline.test.js server/config.test.mjs server/sharedGateway.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-driveready \"node --test tests/rules/firestore.rules.test.js\"",
    "test:shared": "firebase emulators:exec --only auth,firestore --project demo-driveready \"node --test server/sharedAccess.test.mjs server/localSharedGateway.test.mjs server/main.test.mjs\"",
    "test:browser": "firebase emulators:exec --only auth,firestore --project demo-driveready \"playwright test\"",
    "demo:shared": "firebase emulators:exec --only auth,firestore --project demo-driveready \"node scripts/shared-demo.mjs\"",
    "start:service": "node server/main.mjs",
    "check:service": "node --check server/main.mjs && node --check server/sharedGateway.mjs && node --check server/config.mjs && node --check server/sharedAccess.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "firebase-admin": "^14.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
