# Firebase web app configuration. Copy to .env.local after creating a project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# For local tests only; requires the Firebase Authentication emulator on localhost:9099.
VITE_FIREBASE_USE_EMULATORS=false

# Shared learner spaces: the URL of the hosted shared service (server/main.mjs), e.g.
# https://driveready-shared.up.railway.app. Required: without it the app shows a setup notice.
# Must be https, except http://localhost or http://127.0.0.1 for a local service.
VITE_SHARED_API_URL=
