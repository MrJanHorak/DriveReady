rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Browsers can only read shared data. Every write goes through the shared service
    // (server/sharedAccess.mjs), which uses the Admin SDK and bypasses these rules.
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function activeMember(spaceId) {
      let path = /databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid);
      return request.auth != null && exists(path) && get(path).data.active == true &&
        get(path).data.role in ['manager', 'supervisor', 'learner'];
    }
    function spaceManager(spaceId) {
      return activeMember(spaceId) &&
        get(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid)).data.role == 'manager';
    }

    // Discovery index maintained by the service; it never grants access by itself.
    match /users/{uid}/spaceLinks/{spaceId} {
      allow read: if owner(uid);
    }
    match /spaces/{spaceId} {
      allow get: if activeMember(spaceId);
      match /members/{uid} {
        allow get: if activeMember(spaceId) && (owner(uid) || spaceManager(spaceId));
        allow list: if spaceManager(spaceId);
      }
      match /drives/{driveId} {
        allow read: if activeMember(spaceId);
      }
      match /routes/{routeId} {
        allow read: if activeMember(spaceId);
      }
    }
    // Everything else, including the retired single-supervisor records under
    // users/{uid}/learners and users/{uid}/drives, is denied.
  }
}
